# Server
PORT=3000
CORS_ORIGIN=http://localhost:4200

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Redis
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Twilio WhatsApp (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to true when using the Twilio Sandbox number (whatsapp:+14155238886).
# The Twilio Sandbox requires each recipient to opt in by sending a join message.
# When true, WhatsApp reminders are skipped (marked 'skipped') to avoid false 'sent' status.
# Set to false or remove when using a production WhatsApp Business number.
WHATSAPP_SANDBOX_MODE=true

# Frontend URL (used for confirmation links in reminders)
FRONTEND_URL=http://localhost:4200
# Public backend URL (used for Twilio delivery status callbacks and SMS short links)
BACKEND_URL=http://localhost:3000

# Email
# Use smtp while testing Gmail SMTP. Use resend after verifying a domain.
EMAIL_PROVIDER=smtp

# Production: use Resend (HTTPS API — works on Render free tier, no SMTP port issues)
# Sign up free at https://resend.com — 3,000 emails/month free
# The from address must be a verified domain in your Resend account.
RESEND_API_KEY=re_your_resend_api_key_here

# Local dev fallback: Gmail via Nodemailer SMTP (used when RESEND_API_KEY is not set)
EMAIL_USER=your_gmail_address_here
EMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=your_gmail_address_here
SMTP_DIAG_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Web Push (VAPID) — generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=admin@yourdomain.com
